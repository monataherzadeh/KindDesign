---
import Layout from "../layouts/Layout.astro";
---

<main>

  <Layout title="About">
  <section class="about-hero" aria-labelledby="about-hero-title">
    <img
      class="about-hero__image"
      src=" "
      alt="A picture of an event crowd"
    />
    <h1 class="about-hero__title" id="about-hero-title">
      A community for all kinds <br />of designers and creatives.
    </h1>
  </section>

  <section class="about-row what-we-do" aria-labelledby="what-we-do-title">
    <h2 class="about-row__title" id="what-we-do-title">What we do</h2>
    <div class="about-row__content">
      <p class="what-we-do__text">
        We are a community created for all kinds of designers and creatives to come together, connect and share ideas. Our meet-ups create a relaxed space to share experiences, talk about working in design and build inspiring connections. No bragging, no competition, just common passion.
      </p>
    </div>
  </section>

  <section class="about-row team" aria-labelledby="team-title">
    <h2 class="about-row__title" id="team-title">Who’s behind it</h2>
    <div class="about-row__content">
      <img
        class="team__image"
        src=" "
        alt="Picture of people talking at event"
      />

      <ul class="team__list">
        <li class="team__item">
          <article class="person">
            <h3 class="person__name">Julia Kulbaczewska</h3>
            <p class="person__role">Co-founder · Digital Designer at DEPT®</p>
          </article>
        </li>
        <li class="team__item">
          <article class="person">
            <h3 class="person__name">Jeremy Bohdan</h3>
            <p class="person__role">Co-founder · Founder of Double 2 Studio</p>
          </article>
        </li>
      </ul>
    </div>
  </section>

  <section class="about-row involved" aria-labelledby="involved-title">
    <h2 class="about-row__title" id="involved-title">Get involved</h2>
    <div class="about-row__content">
      <ul class="involved__list">
        <li class="involved__item">
          <a class="link" href="#">Volunteer <span aria-hidden="true">→</span></a>
          <p class="involved__text">Help set up, welcome guests and keep the event running.</p>
        </li>
        <li class="involved__item">
          <a class="link" href="#">Host or speak <span aria-hidden="true">→</span></a>
          <p class="involved__text">Got a space, a story or a skill to share? Let’s plan an event.</p>
        </li>
        <li class="involved__item">
          <a class="link" href="#">Partner <span aria-hidden="true">→</span></a>
          <p class="involved__text">Support an event with a venue, drinks or a speaker.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="about-row contact" aria-labelledby="contact-title">
    <h2 class="about-row__title" id="contact-title">Contact</h2>
    <div class="about-row__content">
      <ul class="contact__list">
        <li class="contact__item">
          <a class="link" href="#">Instagram <span aria-hidden="true">→</span></a>
        </li>
        <li class="contact__item">
          <a class="link" href="mailto:">Email <span aria-hidden="true">→</span></a>
        </li>
      </ul>
    </div>
  </section>

  <section class="about-row partners" aria-labelledby="partners-title">
    <h2 class="about-row__title" id="partners-title">Partners</h2>
    <div class="about-row__content">
      <p class="partners__intro">
        Kind Design events are made together with studios, tools and spaces that
        share the passion.
      </p>

      <ul class="partners__list">
        <li class="partners__item">
          <span class="partners__name">[ READYMAG ]</span>
          <span class="partners__relation">Supported by</span>
          <span class="partners__event">Kinddesign Talks · 26.03</span>
          <a class="link partners__link" href="#">See the recap <span aria-hidden="true">→</span></a>
        </li>
        <li class="partners__item">
          <span class="partners__name">[ DEPT ]</span>
          <span class="partners__relation">Hosted at</span>
          <span class="partners__event">AI Skill sharing · 29.10</span>
        </li>
        <li class="partners__item">
          <span class="partners__name">[ THEODORA EXTRA ]</span>
          <span class="partners__relation">Hosted at</span>
          <span class="partners__event">First meetup in Barcelona · 14.05</span>
        </li>
        <li class="partners__item">
          <span class="partners__name">[ BERNIE'S COWORKING ]</span>
          <span class="partners__relation">Hosted at</span>
          <span class="partners__event">AI Real Talk · before summer</span>
        </li>
      </ul>

      <a class="button button--small" href="#">
        Become a partner <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  </Layout>

</main>