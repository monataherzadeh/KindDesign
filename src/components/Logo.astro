---
<Tag href={href ?? undefined} class:list={["logo", { "logo--light": light }]} aria-label="Kind Design">
  <span>KIND</span>
  <span class="logo__slot">
    <span class="logo__br logo__br--l"></span>
    <span class="logo__content">
      <span class="logo__word" data-words={JSON.stringify(words)} data-smile={smile} set:html={first} />
    </span>
    <span class="logo__br logo__br--r"></span>
  </span>
  <span>DESIGN</span>
</Tag>

<style>
  /* Alle mål er i em, så logoet skalerer med font-size (header 35px, footer 162px).
    */
  .logo {
    display: inline-flex; align-items: center; gap: 0.094em;
    font-weight: var(--font-weight-medium); line-height: 1; white-space: nowrap;
    text-decoration: none; color: var(--ink);
  }
  .logo--light { color: var(--off-white); }

  .logo__slot { display: inline-flex; align-items: center; gap: 0.094em; height: 0.94em; }

  /* Tegnede parenteser: 0,086em streg, 0,26em brede, 0,94em høje */
  .logo__br { display: block; width: 0.26em; height: 100%; border: 0.086em solid currentColor; }
  .logo__br--l { border-right: 0; }
  .logo__br--r { border-left: 0; }

  /* Indholdet i parentesen er halv størrelse. Døren = max-width animeres. */
  .logo__content {
    display: inline-flex; align-items: center; justify-content: center; overflow: hidden;
    font-size: 0.5em; line-height: 1.2;
    max-width: 6em; padding: 0.25em 0.375em;
    transition: max-width 1s var(--ease-out), padding 1s var(--ease-out);
  }
  .logo__content.is-closed {
    max-width: 0; padding-left: 0; padding-right: 0;
    transition: max-width 0.9s var(--ease-soft), padding 0.9s var(--ease-soft);
  }

  /* Opløsning (dissolve) som i pitchen: ordet slører og toner ud, mens dørene lukker */
  .logo__word {
    display: inline-flex; align-items: center;
    transition: filter 1s var(--ease-out), opacity 1s var(--ease-out);
  }
  .logo__content.is-closed .logo__word {
    filter: blur(0.2em); opacity: 0;
    transition: filter 0.9s var(--ease-soft), opacity 0.9s var(--ease-soft);
  }

  /* Smilet er 25/35 af logoets højde */
  :global(.logo__smile) { display: block; height: 1.43em; width: auto; }

  @media (prefers-reduced-motion: reduce) { .logo__content, .logo__word { transition: none; } }
</style>

<script>
  // Luk 0,9 s (ordet opløses) → skift → åbn 1 s → vis 3 s.
  // 3 runder gennem alle ord, så stopper logoet på det første (CPH).
  // Stopper efter ca. 1 min (WCAG 2.2.2: bevægelse over 5 sek. skal kunne stoppe).
  const CLOSE = 900, OPEN = 1000, HOLD = 3000, ROUNDS = 3;

  document.querySelectorAll(".logo__word").forEach((el) => {
    const words = JSON.parse(el.dataset.words);
    const smile = el.dataset.smile;
    const box = el.parentElement;
    if (words.length < 2 || matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let i = 0;
    let changes = 0;
    const total = words.length * ROUNDS; // fx 4 ord × 3 runder = 12 skift

    function next() {
      box.classList.add("is-closed");
      setTimeout(() => {
        i = (i + 1) % words.length;
        el.innerHTML = words[i] === "smile" ? smile : words[i];
        box.classList.remove("is-closed");
        changes++;
        if (changes < total) setTimeout(next, OPEN + HOLD);
      }, CLOSE);
    }
    setTimeout(next, HOLD);
  });
</script>
