// KIND[ CPH ]DESIGN – det dynamiske logo
// Rækkefølge: CPH → 13.11 → TALK → smil. Kører 3 runder og stopper på CPH.
// Overgang som i pitchen: indholdet opløses (blur + fade), mens dørene lukker,
// og det nye indhold kommer skarpt frem, når de åbner.
// Props:
//   words = ordene i parentesen. 
//   light = lys tekst (til mørk baggrund, fx logoboksen i headeren)
//   href  = link (sæt til null, hvis logoet ikke skal være et link, fx i footeren)
const { words = ["CPH", "13.11", "TALK", "smile"], light = false, href = "/" } = Astro.props;
const Tag = href ? "a" : "div";

