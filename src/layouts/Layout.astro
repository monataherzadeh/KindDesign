---
// Layout: samler <head>, Header og Footer. Sidens indhold kommer ind i <slot />.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../css/global.css";
const { title = "Kind Design" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Krav fra opgaven: sitet må ikke indekseres -->
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} | KIND[ CPH ]DESIGN</title>
    <!-- Skriften hentes lokalt fra public/fonts (se global.css). Preload = Geist er klar med det samme -->
    <link rel="preload" href="/fonts/Geist-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Geist-Medium.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
